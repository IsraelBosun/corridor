{
  "expo": {
    "name": "Corridor",
    "slug": "corridor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corridor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.israelbosun.corridor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123B2F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "package": "com.israelbosun.corridor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#123B2F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Corridor shows where you are on your own map. It is never stored or shared."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#123B2F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F5F5F2",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0D1814",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F5F2"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94813780-bf80-4edd-ae01-43016907188e"
      }
    },
    "owner": "israelbosun"
  }
}
