# Copy to .env and fill in. Never commit .env.

# The verified email domain for the closed group. Rule 3 keeps the real value
# out of the repo, so this file carries a placeholder only.
EXPO_PUBLIC_WORK_DOMAIN=example.com

# Supabase. Both of these are public by design: they are inlined into the app
# bundle by Metro and readable by anyone who unzips the APK. Row level security
# is what protects the data, not these strings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The service role key is NOT here and must never be. It bypasses every policy
# in supabase/migrations/20260920120100_rls.sql. If it ever needs to exist on
# this machine, it goes somewhere without an EXPO_PUBLIC_ prefix and without a
# path inside app/.

# Mapbox public token, for map tiles and place search. A pk. token is meant to
# ship inside the client and is not a secret, but it still belongs here rather
# than in the source so it can be rotated without a code change.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR-MAPBOX-PUBLIC-TOKEN

# Which backend the app talks to. "local" keeps everything in SQLite on the
# phone, with test accounts you create in the app (a driver and a passenger,
# say) and sign in as with one tap. Leave it out, or set "supabase", for the
# hosted project. Restart with npx expo start --clear after changing it.
EXPO_PUBLIC_BACKEND=local
